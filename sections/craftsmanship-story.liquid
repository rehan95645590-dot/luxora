<section id="story" class="craftsmanship-story section-spacing" style="background: #141312; color: #FFFFFF; position: relative;">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 5rem; align-items: center;">
      
      <!-- Visual Column -->
      <div style="position: relative;">
        <div style="border: 1px solid rgba(197, 160, 89, 0.4); padding: 1.5rem; border-radius: var(--radius-sm); background: #1C1917;">
          <div style="aspect-ratio: 4/5; background: radial-gradient(circle at 50% 50%, #3B2A1E 0%, #151311 85%); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem; border-radius: var(--radius-sm); border: 1px dashed rgba(197, 160, 89, 0.3);">
            <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--color-gold);">⚜</div>
            <h4 class="font-serif font-serif-italic" style="color: #FFFFFF; font-size: 1.6rem; margin-bottom: 1rem;">
              "True luxury is felt before it is seen."
            </h4>
            <p style="color: #BAAF9F; font-size: 0.9rem; max-width: 320px;">
              Master leather craftsman burnishing natural beeswax into Italian full-grain hide.
            </p>
          </div>
        </div>

        <div style="position: absolute; bottom: -20px; right: -20px; background: var(--color-gold); color: #141312; padding: 1.25rem 1.75rem; border-radius: var(--radius-sm); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
          <span style="display: block; font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 700;">Artisan Quality</span>
          <span style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 600;">Saddle-Stitched by Hand</span>
        </div>
      </div>

      <!-- Narrative Column -->
      <div>
        <span class="eyebrow" style="color: var(--color-gold);">{{ section.settings.eyebrow }}</span>
        <h2 class="font-serif" style="color: #FFFFFF; margin-bottom: 2rem; line-height: 1.2;">
          {{ section.settings.heading }}
        </h2>
        
        <blockquote style="border-left: 2px solid var(--color-gold); padding-left: 1.5rem; margin-bottom: 2rem; font-style: italic; color: #E0D7CB; font-size: 1.25rem; font-family: var(--font-heading);">
          "{{ section.settings.story_quote }}"
        </blockquote>

        <p style="color: #B2A89A; margin-bottom: 2.5rem; line-height: 1.8;">
          {{ section.settings.story_body }}
        </p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 3rem;">
          <div>
            <h4 style="color: var(--color-gold); font-size: 1.05rem; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.08em;">
              Natural Patina
            </h4>
            <p style="color: #A09789; font-size: 0.88rem; line-height: 1.6;">
              Untreated with toxic synthetics. Our hides deepen with rich golden honey hues over time.
            </p>
          </div>
          <div>
            <h4 style="color: var(--color-gold); font-size: 1.05rem; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.08em;">
              Heirloom Electric Assemblies
            </h4>
            <p style="color: #A09789; font-size: 0.88rem; line-height: 1.6;">
              Silk-wrapped twisted cords and warm 2700K museum-grade LED illumination.
            </p>
          </div>
        </div>

        <a href="{{ section.settings.button_link }}" class="btn btn--outline-gold">
          {{ section.settings.button_text }}
          {% render 'icon-arrow' %}
        </a>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Craftsmanship Story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Heritage Craftsmanship"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where Master Saddle Stitching Meets Warm Amber Glow"
    },
    {
      "type": "text",
      "id": "story_quote",
      "label": "Story Quote",
      "default": "Leather is not merely a material; it is a living medium that captures time, touch, and light."
    },
    {
      "type": "textarea",
      "id": "story_body",
      "label": "Story Body",
      "default": "Every Luxora fixture is wrapped by hand in vegetable-tanned leather sourced from historic family tanneries in Tuscany. Hand-waxed Irish linen thread is stitched using traditional saddlery techniques that date back over two centuries."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Read The Atelier Journal"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/pages/about"
    }
  ]
}
{% endschema %}