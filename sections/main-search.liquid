<section class="main-search section-spacing">
  <div class="container">
    <div style="text-align: center; max-width: 600px; margin: 0 auto 3.5rem;">
      <span class="eyebrow">Atelier Search</span>
      <h1 class="font-serif" style="margin-bottom: 1.5rem;">Search Our Collection</h1>
      <form action="/search" method="get" style="display: flex; gap: 0.5rem; max-width: 460px; margin: 0 auto;">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search leather desk, table, floor lamps..." style="flex-grow: 1; padding: 0.85rem 1.25rem; border: 1px solid var(--color-border); border-radius: 3px; font-size: 0.9rem;">
        <button type="submit" class="btn btn--primary">Search</button>
      </form>
    </div>

    {%- if search.performed -%}
      <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product_card_product: item %}
          {%- endif -%}
        {%- else -%}
          <p style="text-align: center; grid-column: 1/-1; color: var(--color-muted);">No handcrafted fixtures matched your search. Please explore our full catalog.</p>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search Page",
  "settings": []
}
{% endschema %}