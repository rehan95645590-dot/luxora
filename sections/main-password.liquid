<div class="password-main container" style="flex-grow: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 4rem 1.5rem;">
  <div style="max-width: 650px; background: rgba(20,19,18,0.85); backdrop-filter: blur(12px); border: 1px solid rgba(197, 160, 89, 0.4); border-radius: var(--radius-md); padding: 3.5rem 2.5rem; box-shadow: 0 25px 60px rgba(0,0,0,0.7);">
    
    <div style="margin-bottom: 1.5rem;">
      <span class="eyebrow" style="color: var(--color-gold);">London • Florence • New York</span>
      <h1 class="font-serif" style="color: #FFFFFF; font-size: 2.75rem; letter-spacing: 0.15em; text-transform: uppercase; margin-top: 0.5rem; line-height: 1.1;">
        LUXORA
      </h1>
      <span style="font-size: 0.8rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-gold);">Atelier Lighting</span>
    </div>

    <h2 class="font-serif" style="color: #F3EFEA; font-size: 1.6rem; margin-bottom: 1rem; font-weight: 400;">
      {{ section.settings.heading }}
    </h2>

    <p style="color: #C8BFB3; font-size: 0.98rem; line-height: 1.7; margin-bottom: 2.5rem;">
      {{ section.settings.description }}
    </p>

    <!-- VIP Collector Signup -->
    {% form 'customer', class: 'password-signup-form' %}
      <input type="hidden" name="contact[tags]" value="vip_password_list">
      <div style="display: flex; gap: 0.5rem; max-width: 440px; margin: 0 auto; flex-wrap: wrap;">
        <input
          type="email"
          name="contact[email]"
          placeholder="Enter email for private salon access..."
          required
          style="flex-grow: 1; padding: 0.85rem 1.25rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(197,160,89,0.4); color: #FFFFFF; border-radius: 3px; font-size: 0.9rem;"
        >
        <button type="submit" class="btn btn--gold">
          Join Salon
        </button>
      </div>
      <p style="font-size: 0.75rem; color: #8F877B; margin-top: 0.75rem;">
        Be the first to acquire our debut handcrafted leather lamps.
      </p>
    {% endform %}

    <!-- Enter using Storefront Password -->
    <div style="margin-top: 2.75rem; border-top: 1px solid rgba(255,255,255,0.12); padding-top: 1.75rem;">
      <details style="cursor: pointer;">
        <summary style="color: var(--color-gold); font-size: 0.82rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600;">
          Enter Store Using Password &darr;
        </summary>
        <div style="margin-top: 1.25rem;">
          {% form 'storefront_password', class: 'storefront-password-form' %}
            <div style="display: flex; gap: 0.5rem; max-width: 360px; margin: 0 auto;">
              <input
                type="password"
                name="password"
                placeholder="Storefront password"
                required
                style="flex-grow: 1; padding: 0.75rem 1rem; background: rgba(255,255,255,0.1); border: 1px solid var(--color-border); color: #FFF; border-radius: 3px; font-size: 0.85rem;"
              >
              <button type="submit" class="btn btn--primary" style="padding: 0.75rem 1.25rem; font-size: 0.75rem;">
                Enter
              </button>
            </div>
            {%- if form.errors -%}
              <p style="color: #E57373; font-size: 0.8rem; margin-top: 0.5rem;">
                {{ form.errors.messages['form'] }}
              </p>
            {%- endif -%}
          {% endform %}
        </div>
      </details>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Password Page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sculpted Saddle Leather & Architectural Illumination"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Our online atelier is currently reserved for private viewings and initial batch assembly. Sign up to receive an exclusive invitation to our upcoming collector release."
    }
  ]
}
{% endschema %}