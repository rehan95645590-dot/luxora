<section class="value-props" style="border-bottom: 1px solid var(--color-border); background: #FAF7F2; padding: 3rem 0;">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2.5rem;">
      
      <div style="display: flex; gap: 1rem; align-items: flex-start;">
        <div style="color: var(--color-gold); flex-shrink: 0; padding-top: 3px;">
          {% render 'icon-leather' %}
        </div>
        <div>
          <h4 style="font-size: 0.95rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.25rem;">
            Full-Grain Saddle Leather
          </h4>
          <p style="font-size: 0.85rem; color: var(--color-muted); line-height: 1.5;">
            Hand-burnished vegetable-tanned hides that age with breathtaking character and patina.
          </p>
        </div>
      </div>

      <div style="display: flex; gap: 1rem; align-items: flex-start;">
        <div style="color: var(--color-gold); flex-shrink: 0; padding-top: 3px;">
          {% render 'icon-shield' %}
        </div>
        <div>
          <h4 style="font-size: 0.95rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.25rem;">
            Solid Brass Engineering
          </h4>
          <p style="font-size: 0.85rem; color: var(--color-muted); line-height: 1.5;">
            Turned from solid unlacquered brass hardware designed to endure for generations.
          </p>
        </div>
      </div>

      <div style="display: flex; gap: 1rem; align-items: flex-start;">
        <div style="color: var(--color-gold); flex-shrink: 0; padding-top: 3px;">
          {% render 'icon-truck' %}
        </div>
        <div>
          <h4 style="font-size: 0.95rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.25rem;">
            UK, US & Global Delivery
          </h4>
          <p style="font-size: 0.85rem; color: var(--color-muted); line-height: 1.5;">
            Insured white-glove courier shipping with all import duties covered for US & UK clients.
          </p>
        </div>
      </div>

      <div style="display: flex; gap: 1rem; align-items: flex-start;">
        <div style="color: var(--color-gold); flex-shrink: 0; padding-top: 3px;">
          {% render 'icon-star' %}
        </div>
        <div>
          <h4 style="font-size: 0.95rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.25rem;">
            Tailored Voltage & Plugs
          </h4>
          <p style="font-size: 0.85rem; color: var(--color-muted); line-height: 1.5;">
            Equipped with native UK 3-pin (230V) or US 2-pin (120V) braided silk wiring.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxury Value Pillars",
  "settings": []
}
{% endschema %}