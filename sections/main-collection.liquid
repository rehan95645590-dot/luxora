<section class="main-collection section-spacing">
  <div class="container">
    <div style="text-align: center; max-width: 700px; margin: 0 auto 3.5rem;">
      <span class="eyebrow">Handcrafted Illuminations</span>
      <h1 class="font-serif" style="margin-bottom: 1rem;">
        {{ collection.title | default: section.settings.heading }}
      </h1>
      <p class="text-muted">
        {{ collection.description | default: section.settings.description }}
      </p>
    </div>

    <!-- Filters & Sort Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border); padding-bottom: 1.25rem; margin-bottom: 3rem; font-size: 0.85rem;">
      <span class="text-muted">Showing {{ collection.all_products_count | default: 8 }} Masterworks</span>
      
      <div style="display: flex; gap: 1rem; align-items: center;">
        <span style="text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted);">Filter by Finish:</span>
        <button class="badge-leather-tag" style="cursor: pointer;">All Leathers</button>
      </div>
    </div>

    <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          {% render 'product-card', product_card_product: product %}
        {%- endfor -%}
      {%- else -%}
        {% render 'product-card' %}
        {% render 'product-card' %}
        {% render 'product-card' %}
        {% render 'product-card' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Full Leather Lamp Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Handcrafted table, desk, and floor lamps wrapped in premium vegetable-tanned leather with bespoke international electrical specifications."
    }
  ]
}
{% endschema %}