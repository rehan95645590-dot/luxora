<section class="collections-grid section-spacing">
  <div class="container">
    <div style="text-align: center; max-width: 600px; margin: 0 auto 3.5rem;">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="font-serif">{{ section.settings.heading }}</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
      <a href="/collections/desk-lamps" style="position: relative; aspect-ratio: 1; border-radius: var(--radius-sm); overflow: hidden; background: #26211C; display: flex; flex-direction: column; justify-content: flex-end; padding: 2rem; border: 1px solid var(--color-border); box-shadow: var(--shadow-subtle);">
        <div style="position: absolute; inset: 0; background: radial-gradient(circle, rgba(139,90,43,0.3) 0%, rgba(20,19,18,0.85) 100%);"></div>
        <div style="position: relative; z-index: 2;">
          <span style="font-size: 0.75rem; color: var(--color-gold); text-transform: uppercase; letter-spacing: 0.15em; font-weight: 600;">Executive Workspaces</span>
          <h3 class="font-serif" style="color: #FFFFFF; font-size: 1.75rem; margin-top: 0.25rem;">Leather Desk Lamps</h3>
          <span style="color: #D4CBBE; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; margin-top: 0.75rem;">
            Explore Collection {% render 'icon-arrow' %}
          </span>
        </div>
      </a>

      <a href="/collections/table-lamps" style="position: relative; aspect-ratio: 1; border-radius: var(--radius-sm); overflow: hidden; background: #221F1C; display: flex; flex-direction: column; justify-content: flex-end; padding: 2rem; border: 1px solid var(--color-border); box-shadow: var(--shadow-subtle);">
        <div style="position: absolute; inset: 0; background: radial-gradient(circle, rgba(197,160,89,0.25) 0%, rgba(20,19,18,0.85) 100%);"></div>
        <div style="position: relative; z-index: 2;">
          <span style="font-size: 0.75rem; color: var(--color-gold); text-transform: uppercase; letter-spacing: 0.15em; font-weight: 600;">Living & Bedside</span>
          <h3 class="font-serif" style="color: #FFFFFF; font-size: 1.75rem; margin-top: 0.25rem;">Table & Accent Lamps</h3>
          <span style="color: #D4CBBE; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; margin-top: 0.75rem;">
            Explore Collection {% render 'icon-arrow' %}
          </span>
        </div>
      </a>

      <a href="/collections/floor-lamps" style="position: relative; aspect-ratio: 1; border-radius: var(--radius-sm); overflow: hidden; background: #1F1C1A; display: flex; flex-direction: column; justify-content: flex-end; padding: 2rem; border: 1px solid var(--color-border); box-shadow: var(--shadow-subtle);">
        <div style="position: absolute; inset: 0; background: radial-gradient(circle, rgba(139,90,43,0.3) 0%, rgba(20,19,18,0.85) 100%);"></div>
        <div style="position: relative; z-index: 2;">
          <span style="font-size: 0.75rem; color: var(--color-gold); text-transform: uppercase; letter-spacing: 0.15em; font-weight: 600;">Architectural Scale</span>
          <h3 class="font-serif" style="color: #FFFFFF; font-size: 1.75rem; margin-top: 0.25rem;">Reading Floor Lamps</h3>
          <span style="color: #D4CBBE; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; margin-top: 0.75rem;">
            Explore Collection {% render 'icon-arrow' %}
          </span>
        </div>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Explore by Category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated Illumination Categories"
    }
  ]
}
{% endschema %}